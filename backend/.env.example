# Copy to .env for local dev. In production, set these as real environment
# variables on your host (Render dashboard → Environment) — never commit
# a real .env file.

# Local dev: leave as sqlite. Production: a Postgres URL, e.g. from Neon —
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./afroica_dev.db

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=changeme-generate-a-real-secret

# Admin dashboard (admin/) login — a single operator identity, not a user
# account. ADMIN_PASSWORD_HASH is a bcrypt hash, not the plain password —
# generate both the hash and a separate JWT secret with:
#   python -c "from app.security import hash_password; print(hash_password('your-password'))"
#   python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=12345678
ADMIN_JWT_SECRET=changeme-generate-a-different-real-secret

# Your Anthropic API key (console.anthropic.com) — powers the Pro chat path.
ANTHROPIC_API_KEY=

# Optional — powers the free tier's fast path (an open-weight model on
# Groq's genuinely free, no-card-required tier: console.groq.com/keys).
# Leave blank and the free tier just falls back to on-device WebLLM
# immediately, same as before this existed — nothing breaks without it,
# it's just slower to open. Shared across every free-tier user of the
# app, so it can hit Groq's own rate limit under load — that's expected
# and handled by the same automatic fallback.
GROQ_API_KEY=

# Stripe test-mode keys (dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# From the Stripe CLI (`stripe listen`) locally, or the webhook endpoint's
# signing secret in the dashboard once deployed.
STRIPE_WEBHOOK_SECRET=
# Price IDs from Products in the Stripe dashboard (see README setup steps).
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Where Stripe Checkout/Portal redirect back to. Also used to build the
# password-reset link emailed to users (see app/routers/auth.py).
FRONTEND_URL=http://localhost:8080

# Optional — sends real password-reset emails via Resend (resend.com), which
# has a genuinely free tier (100/day, 3,000/month). Leave RESEND_API_KEY
# blank for local dev: reset emails just get logged to the backend console
# instead, and the link in them still works.
RESEND_API_KEY=
EMAIL_FROM=Afroica AI <onboarding@resend.dev>

# Comma-separated list of origins allowed to call this API. Includes the
# admin dashboard's default local port (8081) alongside the main app's (8080).
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
